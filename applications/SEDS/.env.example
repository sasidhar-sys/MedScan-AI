# ======================================================
# MedScan AI Environment Configuration
# ======================================================

# =====================================
# COMPANY
# =====================================
COMPANY_NAME=MedScan AI

# =====================================
# PRODUCT
# =====================================
PROJECT_NAME=Smart Esophageal Diagnosis System
PROJECT_SHORT_NAME=SEDS
PROJECT_VERSION=1.0.0

ENVIRONMENT=development
DEBUG=True

# ==========================
# SERVER
# ==========================
HOST=0.0.0.0
PORT=8000

# =====================================
# DATABASE
# =====================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seds_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql://postgres:changeme@localhost:5432/seds_db

# ==========================
# JWT AUTHENTICATION
# ==========================
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================
# AI MODEL PATHS
# ==========================
ENDOSCOPY_MODEL=models/endoscopy/weights/endoscopy_best.pth
BIOPSY_MODEL=models/biopsy/weights/biopsy_best.pth
CLINICAL_MODEL=models/clinical/weights/clinical_best.pkl
FUSION_MODEL=models/fusion/weights/fusion_best.pth

# ==========================
# DATASET PATHS
# ==========================
ENDOSCOPY_DATASET=datasets/endoscopy
BIOPSY_DATASET=datasets/biopsy
CLINICAL_DATASET=datasets/clinical

# ==========================
# FILE STORAGE
# ==========================
UPLOAD_FOLDER=uploads
REPORT_FOLDER=reports
LOG_FOLDER=logs

MAX_UPLOAD_SIZE_MB=100

# ==========================
# EXPLAINABLE AI
# ==========================
ENABLE_GRADCAM=True
ENABLE_SCORECAM=True
ENABLE_SHAP=True

# ==========================
# REPORT GENERATION
# ==========================
HOSPITAL_NAME=MedScan AI Hospital
REPORT_AUTHOR=MedScan AI

# ==========================
# GEMINI API
# ==========================
GEMINI_API_KEY=YOUR_API_KEY_HERE

# ==========================
# RAG
# ==========================
VECTOR_DB=vector_db

# ==========================
# LOGGING
# ==========================
LOG_LEVEL=INFO

# ==========================
# CORS
# ==========================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================
# EMAIL
# ==========================
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# ==========================
# CLOUD
# ==========================
AWS_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
